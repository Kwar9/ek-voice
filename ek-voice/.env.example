# Google Cloud Text-to-Speech. Keep this server-only; never prefix with NEXT_PUBLIC_.
GOOGLE_TTS_API_KEY=

# Optional: monthly app-level character ceiling for Google voices (default 250000).
GOOGLE_MONTHLY_CHARACTER_CAP=250000

# Required for reliable shared rate limiting and monthly character caps on public/serverless deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional site origin used for canonical/metadata URLs once deployed.
NEXT_PUBLIC_SITE_URL=

# Optional Supabase Auth + private audio history storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional default server-side premium provider (never required for user BYOK).
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: URL extractor policy. Leave default unless you have a reason.
ARTICLE_FETCH_TIMEOUT_MS=10000
